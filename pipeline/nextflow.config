// Default parameters. Paths are resolved relative to launchDir (where you
// invoke `nextflow run`, meant to be the repo root) for anything that reads
// or writes the project's data/results, and relative to projectDir (this
// pipeline/ directory) for the repo's own static files (configs/), so the
// pipeline works the same regardless of where it's launched from.
params {
    data_dir        = "${launchDir}/data"
    raw_dir         = "${params.data_dir}/raw"
    feature_dir     = "${params.data_dir}/features"
    checkpoints_dir = "${launchDir}/checkpoints"
    export_dir      = "${launchDir}/export"
    results_dir     = "${launchDir}/results"
    cpp_dir         = "${projectDir}/../cpp"

    lstm_config           = "${projectDir}/../configs/lstm_baseline.yaml"
    lstm_attention_config = "${projectDir}/../configs/lstm_attention.yaml"
    transformer_config    = "${projectDir}/../configs/transformer.yaml"

    device       = 'cpu'   // overridden to 'cuda' by -profile gpu
    max_images   = 0       // 0 = full dataset; -profile test overrides this
    epochs       = 0       // 0 = use each config's own epoch count; -profile test overrides this
    beam_size    = 3
}

profiles {
    // Runs every process directly on this machine: needs `v2w` installed
    // (pip install -e .), and for CPP_BENCHMARK, a C++ toolchain (cmake +
    // a compiler) and ONNX Runtime fetched via cpp/scripts/fetch_third_party.*
    // already on PATH. Tested on Ubuntu 24.04 with build-essential and cmake.
    local {
        process.executor = 'local'
    }

    // Runs every process inside the project's own Docker images instead of
    // whatever happens to be on the host -- see docker/README.md. Needs a
    // working Docker host (this repo's own dev machine couldn't run one --
    // see docker/README.md's note on that).
    docker {
        docker.enabled = true
        process {
            withLabel: 'python_stage' { container = 'vision2words-train:latest' }
            withLabel: 'cpp_stage'    { container = 'vision2words-infer:latest' }
        }
    }

    // Same as `docker`, but requests GPU access and trains on CUDA instead
    // of CPU. Needs the NVIDIA Container Toolkit on the Docker host.
    gpu {
        docker.enabled = true
        docker.runOptions = '--gpus all'
        params.device = 'cuda'
        process {
            withLabel: 'python_stage' { container = 'vision2words-train:latest' }
            withLabel: 'cpp_stage'    { container = 'vision2words-infer:latest' }
        }
    }

    // A handful of images, one epoch per model: exercises every stage of
    // the pipeline in a few minutes instead of the hours a real run takes,
    // to prove the pipeline wiring is correct without needing the real
    // dataset or GPU time.
    test {
        params.max_images = 24
        params.epochs     = 1
        params.beam_size  = 2
    }
}

report {
    enabled   = true
    file      = "${params.results_dir}/pipeline_report.html"
    overwrite = true
}
